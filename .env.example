# Copy to .env.local for development. On cPanel, set these in
# "Setup Node.js App" -> Environment variables.

# MySQL / MariaDB (cPanel -> MySQL Databases; names are usually prefixed, e.g. <cpaneluser>_sofa)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=avara
DB_USER=avara
DB_PASSWORD=

# Random string, min. 32 characters. Changing it logs everyone out.
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=

# Initial admin account, created only when no admin exists yet.
ADMIN_USERNAME=admin
ADMIN_NAME=Administrator
ADMIN_PASSWORD=

# Folder for report photos. Put it OUTSIDE the app folder so redeploys don't delete it,
# e.g. /home/<cpanel-user>/sofa-uploads. Default: ./data/uploads
UPLOAD_DIR=

# Local development only: create demo technicians + sample reports.
SEED_DEMO=false
